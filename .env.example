# Supabase Configuration
# Get these values from your Supabase project dashboard:
# https://supabase.com/dashboard/project/[your-project-id]/settings/api

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Admin Authentication
# Generate hash: node -e "let h=0; process.argv[1].split('').forEach(c=>h=((h<<5)-h)+c.charCodeAt(0)); console.log((h&h).toString(36))" "your-password"
ADMIN_PASSWORD_HASH=your-password-hash-here

# Optional: Clerk Authentication (if you plan to add user auth later)
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key

# Cron Job Security
# Generate a random secret: openssl rand -base64 32
CRON_SECRET=your-random-secret-here