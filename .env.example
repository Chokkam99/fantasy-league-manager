# Supabase Configuration
# Get these values from your Supabase project dashboard:
# https://supabase.com/dashboard/project/[your-project-id]/settings/api

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only database access. Prefer the modern Supabase secret key. The
# service-role key remains supported for existing projects. Never prefix these
# with NEXT_PUBLIC_ or expose them to browser code.
SUPABASE_SECRET_KEY=your-supabase-secret-key
# SUPABASE_SERVICE_ROLE_KEY=your-legacy-service-role-key

# Admin Authentication
# Versioned scrypt verifier used only on the server. Generate it through a
# hidden terminal prompt with: npm run admin:hash-password
ADMIN_PASSWORD_HASH=scrypt.v1.32768.8.3.your-salt.your-derived-key
# Temporary migration escape hatch only. A legacy hash fails closed unless this
# is exactly true. Remove this setting immediately after replacing the hash.
# ALLOW_LEGACY_ADMIN_PASSWORD_HASH=true
# Separate server-only key used to sign expiring commissioner sessions.
# Generate with: openssl rand -base64 32
ADMIN_SESSION_SECRET=your-random-session-secret-at-least-32-characters

# Optional: Clerk Authentication (if you plan to add user auth later)
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key

# Cron Job Security
# Generate a random secret: openssl rand -base64 32
CRON_SECRET=your-random-secret-here
